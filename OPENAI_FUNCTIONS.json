{
  "functions": [
    {
      "name": "get_session_context",
      "description": "Retrieve the high-level session context summary including project goals, key decisions, and current status",
      "parameters": {
        "type": "object",
        "properties": {
          "section": {
            "type": "string",
            "description": "Specific section to retrieve",
            "enum": ["summary", "decisions", "architecture", "tech_stack", "next_steps", "all"],
            "default": "all"
          }
        }
      }
    },
    {
      "name": "get_architecture_details",
      "description": "Retrieve detailed technical architecture information",
      "parameters": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "description": "Specific architecture component to retrieve",
            "enum": ["overview", "network", "compute", "data", "auth", "api", "frontend", "ai", "security", "deployment", "all"],
            "default": "all"
          }
        }
      }
    },
    {
      "name": "get_technology_choices",
      "description": "Retrieve detailed rationale for technology stack choices",
      "parameters": {
        "type": "object",
        "properties": {
          "layer": {
            "type": "string",
            "description": "Specific technology layer to retrieve",
            "enum": ["backend", "frontend", "database", "auth", "ai", "notifications", "iac", "monitoring", "all"],
            "default": "all"
          }
        }
      }
    },
    {
      "name": "get_next_steps",
      "description": "Retrieve the prioritized implementation plan",
      "parameters": {
        "type": "object",
        "properties": {
          "timeframe": {
            "type": "string",
            "description": "Specific timeframe to retrieve",
            "enum": ["week1", "week2", "week3", "week4", "post_mvp", "all"],
            "default": "all"
          }
        }
      }
    },
    {
      "name": "get_decision_log",
      "description": "Retrieve architecture decision records (ADRs)",
      "parameters": {
        "type": "object",
        "properties": {
          "adr_number": {
            "type": "string",
            "description": "Specific ADR to retrieve (e.g., '001', '002')",
            "pattern": "^\\d+$"
          },
          "topic": {
            "type": "string",
            "description": "Topic area to filter ADRs",
            "enum": ["infrastructure", "backend", "frontend", "database", "auth", "ai", "monitoring", "security", "all"]
          }
        }
      }
    },
    {
      "name": "search_context",
      "description": "Search for specific information across all context files",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query to find relevant information"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["SESSION_CONTEXT.md", "ARCHITECTURE.md", "TECH_STACK.md", "NEXT_STEPS.md", "DECISIONS_LOG.md", "README.md"]
            },
            "description": "Specific files to search in (default: all)"
          }
        },
        "required": ["query"]
      }
    }
  ]
}