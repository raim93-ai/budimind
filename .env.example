# BudiMind local development configuration. Never commit real credentials.
ENVIRONMENT=development
NODE_ENV=development

NEXT_PUBLIC_CORPORATE_WEB_URL=http://localhost:3000
NEXT_PUBLIC_CORPORATE_API_URL=http://localhost:8000
NEXT_PUBLIC_CLINIC_WEB_URL=http://localhost:3001
NEXT_PUBLIC_CLINICAL_API_URL=http://localhost:8001

# Physically separate databases and service identities.
CORPORATE_DATABASE_URL=mysql+asyncmy://corporate_app:corporate_dev@localhost:3306/budimind_corporate?charset=utf8mb4
CLINICAL_DATABASE_URL=mysql+asyncmy://clinical_app:clinical_dev@localhost:3307/budimind_clinical?charset=utf8mb4

# Local placeholders only. Production must fail closed and load secrets from the deployment secret store.
CORPORATE_SECRET_KEY=local-corporate-placeholder-not-for-production
CLINICAL_SECRET_KEY=local-clinical-placeholder-not-for-production
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Vendor variables are added only with their implementing stage and typed adapter.
