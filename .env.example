# BudiMind local development configuration. Never commit real credentials.
ENVIRONMENT=development
NODE_ENV=development

NEXT_PUBLIC_CORPORATE_WEB_URL=http://localhost:3000
NEXT_PUBLIC_CORPORATE_API_URL=http://localhost:8000
NEXT_PUBLIC_CLINIC_WEB_URL=http://localhost:3001
NEXT_PUBLIC_CLINICAL_API_URL=http://localhost:8001

# Physically separate databases and service identities.
CORPORATE_DATABASE_URL=postgresql+asyncpg://corporate_app:corporate_dev@localhost:5432/budimind_corporate
CLINICAL_DATABASE_URL=postgresql+asyncpg://clinical_app:clinical_dev@localhost:5433/budimind_clinical

# Use the publishable key only in browser code. Secret keys are server-only and bypass RLS.
NEXT_PUBLIC_CORPORATE_SUPABASE_URL=
NEXT_PUBLIC_CORPORATE_SUPABASE_PUBLISHABLE_KEY=
CORPORATE_SUPABASE_SECRET_KEY=
NEXT_PUBLIC_CLINICAL_SUPABASE_URL=
NEXT_PUBLIC_CLINICAL_SUPABASE_PUBLISHABLE_KEY=
CLINICAL_SUPABASE_SECRET_KEY=

# Local auth uses a deterministic fake only in development/test. Production must use Supabase Auth.
AUTH_PROVIDER=fake
AUTH_SESSION_TTL_SECONDS=1800
AUTH_COOKIE_SECURE=true

CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# API-only aliases. Set these in Vercel/Supabase secret stores, never in NEXT_PUBLIC_* variables.
# CORPORATE_SUPABASE_URL=https://<project>.supabase.co
# CORPORATE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# CORPORATE_SUPABASE_SECRET_KEY=<server-only-secret>
# CLINICAL_SUPABASE_URL=https://<project>.supabase.co
# CLINICAL_SUPABASE_PUBLISHABLE_KEY=<publishable-key>
# CLINICAL_SUPABASE_SECRET_KEY=<server-only-secret>

# Vendor variables are added only with their implementing stage and typed adapter.
