# BudiMind Environment Configuration
# Copy this file to .env and fill in actual values
# NEVER commit .env files with real credentials to version control

# =============================================================================
# Application Settings
# =============================================================================
ENVIRONMENT=development
NODE_ENV=development

# Corporate Web App
NEXT_PUBLIC_CORPORATE_WEB_URL=http://localhost:3000
NEXT_PUBLIC_CORPORATE_API_URL=http://localhost:8000

# Clinic Web App
NEXT_PUBLIC_CLINIC_WEB_URL=http://localhost:3001
NEXT_PUBLIC_CLINICAL_API_URL=http://localhost:8001

# =============================================================================
# Database URLs (separate databases for corporate and clinical)
# =============================================================================
# Corporate API Database
CORPORATE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/budimind_corporate

# Clinical API Database
CLINICAL_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/budimind_clinical

# =============================================================================
# Security
# =============================================================================
# Generate with: openssl rand -hex 32
CORPORATE_SECRET_KEY=your-corporate-secret-key-min-32-chars
CLINICAL_SECRET_KEY=your-clinical-secret-key-min-32-chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# CORS Origins
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# Redis (for caching, sessions, rate limiting)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# AWS / LocalStack (for SQS, S3, Secrets Manager, KMS)
# =============================================================================
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# S3 Buckets
CORPORATE_REPORTS_BUCKET=budimind-corporate-reports
CLINICAL_DOCUMENTS_BUCKET=budimind-clinical-documents

# SQS Queues
CORPORATE_QUEUE_URL=http://localhost:4566/000000000000/corporate-jobs
CLINICAL_QUEUE_URL=http://localhost:4566/000000000000/clinical-jobs

# =============================================================================
# OIDC / Identity Provider (placeholder - configure with real provider)
# =============================================================================
OIDC_ISSUER_URL=https://auth.example.com
OIDC_CLIENT_ID_CORPORATE=corporate-web-client
OIDC_CLIENT_SECRET_CORPORATE=your-corporate-client-secret
OIDC_CLIENT_ID_CLINICAL=clinic-web-client
OIDC_CLIENT_SECRET_CLINICAL=your-clinical-client-secret

# =============================================================================
# Payment Provider (placeholder - Stripe, etc.)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# Email Provider (placeholder - SendGrid, SES, etc.)
# =============================================================================
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@budimind.example.com
EMAIL_FROM_NAME=BudiMind

# =============================================================================
# SMS Provider (placeholder - Twilio, etc.)
# =============================================================================
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+60123456789

# =============================================================================
# Monitoring / Observability (placeholder)
# =============================================================================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318